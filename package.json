{
  "name": "gtask",
  "version": "1.0.0",
  "description": "Windows desktop checklist for game schedules, tasks, and progress",
  "main": "./out/main/index.js",
  "author": "Gtask contributors",
  "license": "MIT",
  "keywords": [
    "desktop-app",
    "windows",
    "game-dashboard",
    "game-task-manager",
    "game-progress-tracker",
    "game-checklist",
    "genshin-impact",
    "honkai-star-rail",
    "zenless-zone-zero",
    "wuthering-waves",
    "electron",
    "vue3",
    "typescript",
    "sqlite"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "local:command": "node out/main/local-command-cli.js",
    "local:mcp": "node out/main/local-mcp-server-cli.js",
    "preview": "electron-vite preview",
    "package:dir": "pnpm build && pnpm licenses:generate && electron-builder --dir",
    "package:portable": "pnpm build && pnpm licenses:generate && electron-builder --win portable --publish never",
    "package:installer": "pnpm build && pnpm licenses:generate && node scripts/build-installer-with-details.mjs",
    "release:verify": "node scripts/verify-portable-release.mjs",
    "release:verify-installer": "node scripts/verify-installer-release.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7",
    "zod": "4.0.0"
  },
  "build": {
    "appId": "com.gachataskmanager.app",
    "productName": "Gtask",
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh-TW"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.txt",
      "!node_modules/pngjs/coverage/**",
      "!node_modules/qrcode/bin/**"
    ],
    "extraResources": [
      {
        "from": "integrations/gacha-task-manager",
        "to": "codex-plugin"
      },
      {
        "from": "out/main",
        "to": "codex-mcp-runtime"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.${ext}",
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Gtask",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
