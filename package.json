{
  "name": "gtask",
  "version": "0.1.0-rc.26",
  "description": "可扩展的本地游戏任务与进度清单",
  "main": "./out/main/index.js",
  "author": "Gtask contributors",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "local:command": "node out/main/local-command-cli.js",
    "local:mcp": "node out/main/local-mcp-server-cli.js",
    "preview": "electron-vite preview",
    "package:dir": "pnpm build && pnpm licenses:generate && electron-builder --dir",
    "package:portable": "pnpm build && pnpm licenses:generate && electron-builder --win portable",
    "release:verify": "node scripts/verify-portable-release.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7",
    "zod": "4.0.0"
  },
  "build": {
    "appId": "com.gachataskmanager.app",
    "productName": "Gtask",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "extraResources": [
      {
        "from": "integrations/gacha-task-manager",
        "to": "codex-plugin"
      },
      {
        "from": "out/main",
        "to": "codex-mcp-runtime"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
